{
  "name": "nodevil",
  "version": "0.0.1",
  "description": "A robust Node.js backend framework",
  "license": "MIT",
  "author": "thevilx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thevilx/nodevil.git"
  },
  "keywords": [
    "nodejs",
    "framework",
    "fast",
    "api",
    "backend"
  ],
  "main": "dist/server.js",
  "scripts": {
    "create-model": "ts-node snippets/create_model.snippet.ts",
    "remove-model": "ts-node snippets/remove_model.snippet.ts",
    "build": "tsc",
    "dev": "nodemon --exec ts-node --files src/server.ts",
    "start": "node dist/server.js",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration",
    "test:debug": "cross-env NODE_ENV=test node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:ci": "cross-env NODE_ENV=test jest --ci --coverage --watchAll=false",
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t server-app .",
    "docker:run": "docker run -p 8000:8000 server-app",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:dev": "docker-compose --profile dev up -d",
    "docker:logs": "docker-compose logs -f app"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.815.0",
    "@types/multer": "^1.4.12",
    "@types/qs": "^6.14.0",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mkdirp": "^3.0.1",
    "mongoose": "^8.15.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "node-polyglot": "^2.6.0",
    "nodemon": "^3.1.10",
    "prom-client": "^15.1.3",
    "qs": "^6.14.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.19",
    "@types/node-polyglot": "^2.5.0",
    "@types/semver": "^7.7.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.0.4",
    "lint-staged": "^16.1.5",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.6.2",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
