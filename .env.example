# Application Configuration
NODE_ENV=development
APP_URL=http://localhost:3000
SERVER_URL=http://localhost:8000
PORT=8000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/your_database_name
TEST_MONGO_URI=mongodb://localhost:27017/test_database_name

# Security Configuration
JWT_SECRET=your_super_secure_jwt_secret_key_here

# SMTP Configuration
SMTP_URL=smtp.yandex.com
SMTP_PORT=465
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_email_password

# Admin Configuration
ADMIN_PASSWORD=secure_admin_password
ADMIN_NUMBER=+1234567890
ADMIN_EMAIL=admin@yourdomain.com

# Storage Configuration
STORAGE_DRIVER=local

# AWS S3 Configuration (if using S3)
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC=your-access-key
AWS_S3_SECRET=your-secret-key
AWS_S3_REGION=us-east-1

# Local Storage Configuration (if using local)
LOCAL_STORAGE_PATH=public
LOCAL_STORAGE_URL=/public

# Apple Authentication Configuration
APPLE_CLIENT_ID=your.apple.client.id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nyour_apple_private_key_content\n-----END PRIVATE KEY-----

# Google Authentication Configuration
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret




